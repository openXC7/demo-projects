create_clock -period 10.000 -name clk [get_ports clk]
set_property PACKAGE_PIN E3 [get_ports clk]
set_property PACKAGE_PIN A8 [get_ports wa0]
set_property PACKAGE_PIN C11 [get_ports wa1]
set_property PACKAGE_PIN C10 [get_ports wb0]
set_property PACKAGE_PIN A10 [get_ports wb1]
set_property PACKAGE_PIN H5 [get_ports led]
set_property IOSTANDARD LVCMOS33 [get_ports clk]
set_property IOSTANDARD LVCMOS33 [get_ports wa0]
set_property IOSTANDARD LVCMOS33 [get_ports wa1]
set_property IOSTANDARD LVCMOS33 [get_ports wb0]
set_property IOSTANDARD LVCMOS33 [get_ports wb1]
set_property IOSTANDARD LVCMOS33 [get_ports led]
