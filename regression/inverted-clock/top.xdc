set_property PACKAGE_PIN AB6 [get_ports {a[4]}]
set_property PACKAGE_PIN AB7 [get_ports {a[5]}]
set_property PACKAGE_PIN AB8 [get_ports {a[6]}]
set_property PACKAGE_PIN R2 [get_ports {a[7]}]
set_property PACKAGE_PIN R3 [get_ports {a[8]}]
set_property PACKAGE_PIN R6 [get_ports {a[9]}]
set_property PACKAGE_PIN T1 [get_ports {di[0]}]
set_property PACKAGE_PIN T3 [get_ports {di[1]}]
set_property PACKAGE_PIN T6 [get_ports {bo[0]}]
set_property PACKAGE_PIN U1 [get_ports {bo[1]}]
set_property PACKAGE_PIN U2 [get_ports {lo}]
set_property IOSTANDARD LVCMOS33 [get_ports clk]
